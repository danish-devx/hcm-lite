# ─────────────────────────────────────────────────────────────────────────────
# HCM Lite — environment template
# IS FILE KO `.env.local` (local dev) ME COPY KAREIN AUR ASLI VALUES BHAREIN.
# Vercel par: Settings → Environment Variables me yehi vars set karein.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Gemini) ──
# Key: https://aistudio.google.com/apikey  (bina quotes ke paste karein)
GEMINI_API_KEY=
# Current recommended model — options: gemini-3.5-flash-lite | gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# API base URL — official endpoint (proxy/relay ho to isay badlein)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# auto = Gemini key ho to Gemini, fail par zai fallback | gemini = sirf Gemini | zai = sirf zai
AI_PROVIDER=auto